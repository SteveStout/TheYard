<Project Sdk="Microsoft.NET.Sdk">
  <!-- The job hunt's rules (ADR-117: One host per process, the rings under them): no I/O, no clock read, no
       setting read; references nothing of the job hunt's own. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- The slot table the Admin tab's nightly card reads too, compiled here from its one file so the
         Function and the card cannot keep two tables (ADR: The Nightly Function on the Admin tab). -->
    <Compile Include="..\..\api\TheYard.Domain\Features\Admin\NightlySlots.cs" Link="NightlySlots.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="JobHunt.Domain" />
    <Using Include="JobHunt.Domain.Features.Ats" />
    <Using Include="JobHunt.Domain.Features.Leads" />
    <Using Include="JobHunt.Domain.Features.Merge" />
    <Using Include="JobHunt.Domain.Features.Sheet" />
    <Using Include="JobHunt.Domain.Features.Card" />
    <Using Include="JobHunt.Domain.Features.Campaign" />
    <Using Include="JobHunt.Domain.Features.NetworkLog" />
    <Using Include="JobHunt.Domain.Features.Jobs" />
    <Using Include="TheYard.Domain.Features.Admin" />
    <Using Include="JobHunt.Domain.Shared.Tracker" />
    <Using Include="JobHunt.Domain.Shared.Clock" />
    <Using Include="JobHunt.Domain.Shared.Mail" />
    <Using Include="JobHunt.Domain.Shared.Companies" />
    <Using Include="JobHunt.Domain.Shared.Writing" />
    <Using Include="JobHunt.Domain.Shared.Applications" />
    <Using Include="JobHunt.Domain.Shared.Postings" />
    <Using Include="JobHunt.Domain.Shared.Pay" />
  </ItemGroup>
</Project>
