[
  {
    "name": "Nightly",
    "scriptFile": "JobHunt.Functions.dll",
    "entryPoint": "JobHunt.Functions.Nightly.RunAsync",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "timer",
        "direction": "In",
        "type": "timerTrigger",
        "schedule": "0 0 9,10 * * *",
        "properties": {}
      }
    ]
  }
]