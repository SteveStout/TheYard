<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.0.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.2.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.0" />
    <PackageReference Include="Azure.Storage.Files.Shares" Version="12.21.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The rings under the host (ADR-117): the host composes them and binds the triggers. -->
    <ProjectReference Include="..\JobHunt.Infrastructure\JobHunt.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="JobHunt.Domain" />
    <Using Include="JobHunt.Domain.Features.Ats" />
    <Using Include="JobHunt.Domain.Features.Leads" />
    <Using Include="JobHunt.Domain.Features.Merge" />
    <Using Include="JobHunt.Domain.Features.Sheet" />
    <Using Include="JobHunt.Domain.Features.Card" />
    <Using Include="JobHunt.Domain.Features.Campaign" />
    <Using Include="JobHunt.Application" />
    <Using Include="JobHunt.Application.Features.Ats" />
    <Using Include="JobHunt.Application.Features.Leads" />
    <Using Include="JobHunt.Application.Features.Merge" />
    <Using Include="JobHunt.Application.Features.Sheet" />
    <Using Include="JobHunt.Application.Features.Campaign" />
    <Using Include="JobHunt.Infrastructure" />
    <Using Include="JobHunt.Infrastructure.Features.Ats" />
    <Using Include="JobHunt.Infrastructure.Features.Merge" />
    <Using Include="JobHunt.Infrastructure.Features.Sheet" />
    <Using Include="JobHunt.Infrastructure.Features.Card" />
    <Using Include="JobHunt.Infrastructure.Features.Campaign" />
  </ItemGroup>
  <ItemGroup>
    <None Update="host.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
