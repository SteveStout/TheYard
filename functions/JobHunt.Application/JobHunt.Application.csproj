<Project Sdk="Microsoft.NET.Sdk">
  <!-- The job hunt's use cases and their ports (ADR-117): references Domain only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JobHunt.Domain\JobHunt.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The campaign's approved templates, as Steve approved them (ADR-118): code, changed only with his yes. -->
    <EmbeddedResource Include="Features\Campaign\Templates\*.md" LogicalName="JobHunt.Campaign.Templates.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="JobHunt.Domain" />
    <Using Include="JobHunt.Domain.Features.Ats" />
    <Using Include="JobHunt.Domain.Features.Leads" />
    <Using Include="JobHunt.Domain.Features.Merge" />
    <Using Include="JobHunt.Domain.Features.Sheet" />
    <Using Include="JobHunt.Domain.Features.Card" />
    <Using Include="JobHunt.Domain.Features.Campaign" />
    <Using Include="JobHunt.Application" />
    <Using Include="JobHunt.Application.Features.Ats" />
    <Using Include="JobHunt.Application.Features.Leads" />
    <Using Include="JobHunt.Application.Features.Merge" />
    <Using Include="JobHunt.Application.Features.Sheet" />
    <Using Include="JobHunt.Application.Features.Campaign" />
  </ItemGroup>
</Project>
