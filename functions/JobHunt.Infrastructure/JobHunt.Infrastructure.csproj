<Project Sdk="Microsoft.NET.Sdk">
  <!-- The job hunt's adapters (ADR-117): Gmail, Google Sheets, Google Calendar, the Azure Files share, the
       GitHub dispatch and the campaign's database; the only ring that opens a socket or a file. References Application and Domain. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Azure.Storage.Files.Shares" Version="12.21.0" />
    <!-- The campaign's database (ADR-118, Decision 2), signed into as the Function's managed identity: the same
         client and version the site runs (TheYard.Infrastructure), and the same raised Pkcs, because SqlClient
         6.1.6 brings 9.0.11, which the 13 October advisories cover, and NuGet's audit warning is red here too. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.6" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JobHunt.Application\JobHunt.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="JobHunt.Domain" />
    <Using Include="JobHunt.Domain.Features.Ats" />
    <Using Include="JobHunt.Domain.Features.Leads" />
    <Using Include="JobHunt.Domain.Features.Merge" />
    <Using Include="JobHunt.Domain.Features.Sheet" />
    <Using Include="JobHunt.Domain.Features.Card" />
    <Using Include="JobHunt.Domain.Features.Campaign" />
    <Using Include="JobHunt.Application" />
    <Using Include="JobHunt.Application.Features.Ats" />
    <Using Include="JobHunt.Application.Features.Leads" />
    <Using Include="JobHunt.Application.Features.Merge" />
    <Using Include="JobHunt.Application.Features.Sheet" />
    <Using Include="JobHunt.Application.Features.Campaign" />
    <Using Include="JobHunt.Infrastructure" />
    <Using Include="JobHunt.Infrastructure.Features.Ats" />
    <Using Include="JobHunt.Infrastructure.Features.Merge" />
    <Using Include="JobHunt.Infrastructure.Features.Sheet" />
    <Using Include="JobHunt.Infrastructure.Features.Card" />
    <Using Include="JobHunt.Infrastructure.Features.Campaign" />
  </ItemGroup>
</Project>
