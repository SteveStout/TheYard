    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
  <ItemGroup>
    <!-- The rule bodies both suites share (tests/rules/, ADR-075 the addendum of 1.0.4.70): one rule, one body. -->
    <Compile Include="..\..\tests\rules\*.cs" Link="Rules\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\jobhunt\JobHunt.Functions.csproj" />
  </ItemGroup>
  <ItemGroup>
