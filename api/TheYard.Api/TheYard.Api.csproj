<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- The one email this site sends, the password reset link, as the
         containers' own identity (ADR: Accounts and per-user bids, addendum).
         The Azure.Core this project resolves carries its own copy of the
         credential types the pinned Azure.Identity has, and naming one here
         is ambiguous to the compiler, so the credential is built in the
         Cosmos DB project against the pinned library and handed over as a
         TokenCredential; no credential type is named in this project. -->
    <PackageReference Include="Azure.Communication.Email" Version="1.1.0" />
    <!-- Azure Monitor's OpenTelemetry distro: requests, dependencies and
         exceptions to Application Insights with one call in Program.cs, and
         nothing at all when the connection string is absent (ADR-024). -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- The API's description of itself: the framework's own OpenAPI generator,
         which reads the routing table and the typed results, and Scalar for the
         page a person opens at /api/reference. Both pinned; the generator to
         the same servicing line as the rest of ASP.NET Core here, Scalar to the
         version its bundled assets were read on (ADR: The API describes itself). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheYard.Application\TheYard.Application.csproj" />
    <ProjectReference Include="..\TheYard.Infrastructure\TheYard.Infrastructure.csproj" />
    <!-- The second store, chosen at startup by the presence of an account
         endpoint (ADR: A second store on Cosmos DB, and what it costs). -->
    <ProjectReference Include="..\TheYard.Infrastructure.Cosmos\TheYard.Infrastructure.Cosmos.csproj" />
    <!-- Referenced so the assembly lands beside the host: EF resolves a
         migrations assembly by name at run time, and a name that is not loaded
         is a migration that does not exist. Only SQLite has migrations; the SQL
         Server schema is the SQL project (ADR: Data first, and the database in
         source control). -->
    <ProjectReference Include="..\TheYard.Migrations.Sqlite\TheYard.Migrations.Sqlite.csproj" />
    <!-- The Shed, the getting-started sample beside this app, served by this process under its own
         name since 19 October (Composition/ShedMount.cs; ADR: One web app for every .NET process).
         Referenced for its assembly only: its documents, sample home and page are published to a
         folder of their own by the Dockerfile and read from there, so none of its files is copied
         beside this app's, where its appsettings.json and README.md would collide with these. -->
    <ProjectReference Include="..\..\samples\theshed\TestProject.csproj" />
  </ItemGroup>

  <!-- #region shared-concerns -->
  <!-- The host's shared code, one namespace per concern under Shared/ (ADR-114: The host root holds one file). Every
       file in the host may use a shared concern, so each is imported once here rather than in every file that names
       one; a slice is never imported, because a slice reaching another is what SliceTests rule 1 forbids. -->
  <ItemGroup>
    <Using Include="TheYard.Api.Shared.Activity" />
    <Using Include="TheYard.Api.Shared.Auth" />
    <Using Include="TheYard.Api.Shared.CostReadings" />
    <Using Include="TheYard.Api.Shared.Documentation" />
    <Using Include="TheYard.Api.Shared.Edge" />
    <Using Include="TheYard.Api.Shared.Grades" />
    <Using Include="TheYard.Api.Shared.Hosted" />
    <Using Include="TheYard.Api.Shared.Instance" />
    <Using Include="TheYard.Api.Shared.MachineReadings" />
    <Using Include="TheYard.Api.Shared.Observability" />
    <Using Include="TheYard.Api.Shared.PlanReadings" />
    <Using Include="TheYard.Api.Shared.Proof" />
    <Using Include="TheYard.Api.Shared.Resources" />
    <Using Include="TheYard.Api.Shared.Sites" />
    <Using Include="TheYard.Api.Shared.Stores" />
    <Using Include="TheYard.Api.Shared.Usage" />
    <Using Include="TheYard.Api.Shared.Wire" />
    <Using Include="TheYard.Api.Shared.Wiring" />
    <Using Include="TheYard.Infrastructure.Shared.Http" />
  </ItemGroup>
  <!-- #endregion shared-concerns -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- #region runtime-settings -->
  <!-- How the runtime compiles and collects this process (ADR: Compiled before it ships). Written out even where they
       are the defaults, so the choice is read here and held by CompilationTests rather than inherited silently.
       ReadyToRun itself is a publish switch, in the Dockerfile, so a developer's build and the tests are unchanged. -->
  <PropertyGroup>
    <!-- Tiered compilation with profile-guided optimization: code compiled ahead of time runs first, and the methods
         that turn out hot are compiled again at full optimization with what the first runs measured. -->
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <!-- Workstation collection, background collection on. The web SDK's default is server collection, which keeps a
         heap per core and holds more memory for throughput; on a plan whose memory is the scarcest thing it has, and
         whose one core leaves server collection little to work with, the smaller footprint is the better trade.
         /api/admin/metrics says which mode the live process runs. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <!-- #endregion runtime-settings -->

  <!-- #region shed-files -->
  <!-- The Shed's documents, sample home, page and appsettings.json would be published beside this app's, where its
       appsettings.json and README.md have the same names as this app's and the publish stops (NETSDK1152). They are
       The Shed's, published by the Dockerfile to a folder of its own that Shed__ContentRoot names, so they are left
       out of this publish: only The Shed's assembly comes here, through the project reference. -->
  <Target Name="LeaveTheShedsFilesToItsOwnFolder" AfterTargets="GetCopyToPublishDirectoryItems">
    <PropertyGroup>
      <TheShedFolder>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../samples/theshed/'))</TheShedFolder>
    </PropertyGroup>
    <ItemGroup>
      <_SourceItemsToCopyToPublishDirectory Remove="@(_SourceItemsToCopyToPublishDirectory)" Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$(TheShedFolder)', StringComparison.OrdinalIgnoreCase))" />
      <_SourceItemsToCopyToPublishDirectoryAlways Remove="@(_SourceItemsToCopyToPublishDirectoryAlways)" Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$(TheShedFolder)', StringComparison.OrdinalIgnoreCase))" />
      <_SourceItemsToCopyToPublishDirectoryIfDifferent Remove="@(_SourceItemsToCopyToPublishDirectoryIfDifferent)" Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$(TheShedFolder)', StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>
  </Target>
  <!-- #endregion shed-files -->

</Project>
