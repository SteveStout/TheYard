<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- The one email this site sends, the password reset link, as the
         containers' own identity (ADR: Accounts and per-user bids, addendum).
         The Azure.Core this project resolves carries its own copy of the
         credential types the pinned Azure.Identity has, and naming one here
         is ambiguous to the compiler, so the credential is built in the
         Cosmos DB project against the pinned library and handed over as a
         TokenCredential; no credential type is named in this project. -->
    <PackageReference Include="Azure.Communication.Email" Version="1.1.0" />
    <!-- Azure Monitor's OpenTelemetry distro: requests, dependencies and
         exceptions to Application Insights with one call in Program.cs, and
         nothing at all when the connection string is absent (ADR-024). -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <!-- The API's description of itself: the framework's own OpenAPI generator,
         which reads the routing table and the typed results, and Scalar for the
         page a person opens at /api/reference. Both pinned; the generator to
         the same servicing line as the rest of ASP.NET Core here, Scalar to the
         version its bundled assets were read on (ADR: The API describes itself). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheYard.Application\TheYard.Application.csproj" />
    <ProjectReference Include="..\TheYard.Infrastructure\TheYard.Infrastructure.csproj" />
    <!-- The second store, chosen at startup by the presence of an account
         endpoint (ADR: A second store on Cosmos DB, and what it costs). -->
    <ProjectReference Include="..\TheYard.Infrastructure.Cosmos\TheYard.Infrastructure.Cosmos.csproj" />
    <!-- Referenced so the assembly lands beside the host: EF resolves a
         migrations assembly by name at run time, and a name that is not loaded
         is a migration that does not exist. Only SQLite has migrations; the SQL
         Server schema is the SQL project (ADR: Data first, and the database in
         source control). -->
    <ProjectReference Include="..\TheYard.Migrations.Sqlite\TheYard.Migrations.Sqlite.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
