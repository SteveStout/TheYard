<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TheYard.Application\TheYard.Application.csproj" />
    <!-- For YardUser, the one type the two stores share: an account is the
         same thing whichever store holds it, and OnionTests allows that type
         and nothing else from here (ADR: Onion and SOLID, how this codebase
         holds them). -->
    <ProjectReference Include="..\TheYard.Infrastructure\TheYard.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK directly rather than the EF Core provider, because every
         response carries the request charge and the diagnostics this lane
         exists to show, and the provider surfaces neither
         (ADR: A second store on Cosmos DB, and what it costs). -->
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.63.2" />
    <!-- The SDK insists on an explicit reference to its own serializer even
         when, as here, the documents go through System.Text.Json. 13.0.4 is
         the version already in this application's dependency graph. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- The container's managed identity, or the developer's signed-in Azure
         CLI session. No key exists on the account to fall back to.

         Pinned at 1.17.1, not the newest: SqlClient takes its managed identity
         token through the same library, and 1.21.0 takes longer than
         SqlClient's thirty seconds to find the identity endpoint, so the SQL
         connection is cancelled and the site serves from files. PackagePinTests
         holds the pin (ADR: A second store on Cosmos DB, and what it costs,
         addendum). -->
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
