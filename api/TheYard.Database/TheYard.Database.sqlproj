<Project Sdk="Microsoft.Build.Sql/2.2.0">

  <!-- The database, as the database (ADR: Data first, and the database in
       source control).

       This project is the authority for the SQL Server schema. Entity Framework
       maps to what is here; it does not create it and it has no rights to alter
       it. Every .sql file under this directory is picked up automatically, and
       `dotnet build` compiles them into a DACPAC, which means a column with the
       wrong type or a foreign key pointing at nothing fails the build the same
       way a broken C# file does. -->

  <PropertyGroup>
    <Name>TheYard.Database</Name>
    <!-- Azure SQL Database, which is what this schema is published to. Building
         against the Azure provider is what catches syntax the service does not
         accept before a deploy does. -->
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <SuppressTSqlWarnings></SuppressTSqlWarnings>
  </PropertyGroup>

</Project>
