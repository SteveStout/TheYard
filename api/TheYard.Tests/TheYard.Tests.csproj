    <PackageReference Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- The host's shared concerns (ADR-114), one namespace each, as the host itself imports them. -->
    <Using Include="TheYard.Api.Shared.Activity" />
    <Using Include="TheYard.Api.Shared.Auth" />
    <Using Include="TheYard.Api.Shared.CostReadings" />
    <Using Include="TheYard.Api.Shared.Documentation" />
    <Using Include="TheYard.Api.Shared.Edge" />
    <Using Include="TheYard.Api.Shared.Grades" />
    <Using Include="TheYard.Api.Shared.Hosted" />
    <Using Include="TheYard.Api.Shared.Instance" />
    <Using Include="TheYard.Api.Shared.MachineReadings" />
    <Using Include="TheYard.Api.Shared.Observability" />
    <Using Include="TheYard.Api.Shared.PlanReadings" />
    <Using Include="TheYard.Api.Shared.Proof" />
    <Using Include="TheYard.Api.Shared.Resources" />
    <Using Include="TheYard.Api.Shared.Sites" />
    <Using Include="TheYard.Api.Shared.Stores" />
    <Using Include="TheYard.Api.Shared.Usage" />
    <Using Include="TheYard.Api.Shared.Wire" />
    <Using Include="TheYard.Api.Shared.Wiring" />
    <Using Include="TheYard.Infrastructure.Shared.Http" />
    <Using Include="TheYard.Application.Features.Accounts" />
    <Using Include="TheYard.Application.Features.Admin.Operations" />
    <Using Include="TheYard.Application.Shared.Auction" />
    <Using Include="TheYard.Application.Shared.Caching" />
    <Using Include="TheYard.Application.Shared.Cards" />
    <Using Include="TheYard.Application.Shared.Claude" />
    <Using Include="TheYard.Application.Shared.History" />
    <Using Include="TheYard.Application.Shared.Stores" />
    <Using Include="TheYard.Domain.Features.Admin" />
    <Using Include="TheYard.Domain.Features.Blog" />
    <Using Include="TheYard.Domain.Shared.Visitors" />
    <Using Include="TheYard.Domain.Shared.Auction" />
    <Using Include="TheYard.Domain.Shared.Cards" />
    <Using Include="TheYard.Domain.Shared.Usage" />
    <Using Include="TheYard.Infrastructure.Cosmos.Features.Accounts" />
    <Using Include="TheYard.Infrastructure.Cosmos.Features.Admin" />
    <Using Include="TheYard.Infrastructure.Cosmos.Features.Links" />
    <Using Include="TheYard.Infrastructure.Cosmos.Shared.Auction" />
    <Using Include="TheYard.Infrastructure.Cosmos.Shared.History" />
    <Using Include="TheYard.Infrastructure.Cosmos.Shared.Stores" />
    <Using Include="TheYard.Infrastructure.Features.Admin.Cloud" />
    <Using Include="TheYard.Infrastructure.Shared.Auction" />
    <Using Include="TheYard.Infrastructure.Shared.History" />
    <Using Include="TheYard.Infrastructure.Shared.Stores" />
  </ItemGroup>

  <ItemGroup>
    <!-- The nightly Function's clock, compiled here by the same kind of link the Function uses for
         the slot table, so a test calls the Function's own code (ADR: The Nightly Function on the
         Admin tab, the addendum of 1.0.4.15). It needs Domain and nothing of the Functions SDK. -->
    <Compile Include="..\..\functions\JobHunt.Domain\Shared\Clock\CentralClock.cs" Link="Functions\CentralClock.cs" />
    <!-- The rule bodies both suites share (tests/rules/, ADR-075 the addendum of 1.0.4.70): one rule, one body. -->
    <Compile Include="..\..\tests\rules\*.cs" Link="Rules\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheYard.Domain\TheYard.Domain.csproj" />
    <ProjectReference Include="..\TheYard.Application\TheYard.Application.csproj" />
    <ProjectReference Include="..\TheYard.Infrastructure\TheYard.Infrastructure.csproj" />
    <ProjectReference Include="..\TheYard.Infrastructure.Cosmos\TheYard.Infrastructure.Cosmos.csproj" />
    <ProjectReference Include="..\TheYard.Api\TheYard.Api.csproj" />
  </ItemGroup>

</Project>