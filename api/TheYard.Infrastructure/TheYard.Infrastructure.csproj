<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TheYard.Application\TheYard.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Two providers, one model. Azure SQL Database is where the deployed site
         keeps its data; SQLite is what a developer and a CI runner get, because
         neither has an Azure credential and neither should need one
         (ADR: The SQL Server backend). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!-- Named only to raise a version. SQL Server's client (Microsoft.Data.SqlClient 6.1.6, under the provider
         above) brings System.Security.Cryptography.Pkcs 9.0.11, which two advisories of 13 October 2026 cover
         (GHSA-846f-f764-76mx, high; GHSA-2fmv-rv2c-59x7, moderate), and NuGet's audit is a warning and every
         warning is red. 10.0.13 is the patched release; nothing here calls it (ADR: Technology versions, the
         addendum of 14 October). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
