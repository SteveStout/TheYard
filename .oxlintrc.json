{
  "plugins": ["react", "typescript"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eqeqeq": ["error", "smart"],
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-debugger": "error",
    "no-var": "error",
    "prefer-const": "error",
    "react/rules-of-hooks": "error",
    "react/jsx-key": "error",
    "typescript/no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": ["tests/**", "scripts/**", "docs/**", "*.config.ts", "src/**/*.test.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", "playwright-report", "test-results", "api", "public"]
}
