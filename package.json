{
  "name": "theyard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -k -n api,web -c blue,green \"npm run api\" \"vite --open\"",
    "dev": "vite",
    "api": "dotnet run --project api/TheBlock.Api",
    "docker": "docker build -t theyard:local . && docker run --rm -d -p 8080:8080 --name theyard theyard:local",
    "docker:stop": "docker stop theyard",
    "test:api": "dotnet test api",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.ts\" \"scripts/**/*.mjs\"",
    "format:api": "dotnet format api/TheBlock.slnx",
    "format:api:check": "dotnet format api/TheBlock.slnx --verify-no-changes"
  },
  "dependencies": {
    "marked": "^18.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
