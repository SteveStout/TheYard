{
  "name": "theyard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -k -n api,web -c blue,green \"npm run api\" \"vite --open\"",
    "dev": "vite",
    "api": "dotnet run --project api/TheYard.Api",
    "docker": "docker build -t theyard:local . && docker run --rm -d -p 8080:8080 --name theyard theyard:local",
    "docker:stop": "docker stop theyard",
    "test:api": "dotnet test api --filter Store!=cosmos",
    "build": "tsc -b && vite build",
    "build:render": "vite build --config render/vite.config.ts",
    "render": "node render/server.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "images:resize": "node scripts/resize_photos.mjs",
    "images:author": "node scripts/author_photos.mjs",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"render/**/*.{ts,mjs}\" \"tests/**/*.ts\" \"*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"render/**/*.{ts,mjs}\" \"tests/**/*.ts\" \"*.ts\" \"scripts/**/*.mjs\"",
    "format:api": "dotnet format api/TheYard.slnx",
    "format:api:check": "dotnet format api/TheYard.slnx --verify-no-changes"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
