# The morning canaries (J:\dispatch\canary.py): apply, invites and messages through `JobHunt.Server run --canary`, a dry
# run of one row by construction, plus one board read and one resume check. A lane that fails twice is held for the
# 06:00 run and its heal opens. Installed by server/publish-to-wickedawsome.sh. DISPLAY and XAUTHORITY are the
# auto-login desktop's, because the Chrome the program drives lives there.
[Unit]
Description=JobHunt canaries: one dry row of each machine lane before the 06:00 run
After=network-online.target jdrive.service
Wants=jdrive.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/test -f /mnt/j/dispatch/canary.py
ExecStart=/usr/bin/python3 -I /mnt/j/dispatch/canary.py
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
Environment=TZ=America/Chicago
Environment=DOTNET_ROOT=/usr/lib/dotnet
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=30min
