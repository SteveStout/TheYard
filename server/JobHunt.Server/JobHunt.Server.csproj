<Project Sdk="Microsoft.NET.Sdk">
  <!-- The third process's one deployable (ADR-119): a console program the 06:00 systemd timer starts. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>JobHunt.Server</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JobHunt.Server.Application\JobHunt.Server.Application.csproj" />
    <ProjectReference Include="..\JobHunt.Server.Infrastructure\JobHunt.Server.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="JobHunt.Server.Application.Features.Probe" />
    <Using Include="JobHunt.Server.Application.Features.Run" />
    <Using Include="JobHunt.Server.Application.Features.Status" />
    <Using Include="JobHunt.Server.Application.Shared.Config" />
    <Using Include="JobHunt.Server.Infrastructure.Shared.Cli" />
    <Using Include="JobHunt.Server.Infrastructure.Shared.Share" />
    <Using Include="JobHunt.Server.Infrastructure.Shared.Site" />
  </ItemGroup>
</Project>
