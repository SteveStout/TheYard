# Dependency folders
node_modules/
**/node_modules/

# Git and editor metadata. .vscode/ rides along: the runtime image copies it so the
# editor page can show the launch and task files live (ADR: The editor is set up by the repository).
.git/
.gitignore
.vs/

# Local environment and IDE settings
*.user
*.suo
*.userosscache
*.sln.docstates
*.swp
*.tmp
*.temp
*.log
.env
.env.*

# Test output and reports
playwright-report/
test-results/
**/playwright-report/
**/test-results/

# .NET build artifacts and lock files
**/bin/
**/obj/
**/*.binlog

# The Dockerfile rides along in the context on purpose: the runtime image copies
# it so the records can show it live (ADR-002, ADR-008, ADR-017).

# Optional: keep the repo clean if local artifacts are generated elsewhere
*.orig
