<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The starter's project file, kept as MapLarge sent it (net8.0, nullable, implicit usings)
       with three additions: warnings are errors, the sealed-by-default analyzer is on, and the
       documents plus the sample home travel with a publish so the container serves them (ADR-001). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Include="wwwroot\index.html" />
    <!-- What a publish carries beyond the binaries: the records, the sample home, and the source
         files the live samples read at request time (ADR-012). appsettings.json already travels. -->
    <Content Include="docs\**\*.md;sample-home\**\*" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Data\**\*.cs;Domain\**\*.cs;Application\**\*.cs;Infrastructure\**\*.cs;Controllers\**\*.cs;Docs\**\*.cs;Program.cs;.editorconfig;Dockerfile" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="tests\**" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
