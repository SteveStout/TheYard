<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The starter's project file, kept as MapLarge sent it (nullable, implicit usings) on net10.0, the
       same framework as TheYard (ADR-001), with three additions: warnings are errors, the sealed-by-default analyzer is on, and the
       documents plus the sample home travel with a publish so the container serves them (ADR-001). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Include="wwwroot\index.html" />
    <!-- What a publish carries beyond the binaries: the records, the README the Docs tab serves, the
         sample home, and the source files the live samples read at request time (ADR-012).
         appsettings.json already travels. DocsTests holds it for every document the catalogue lists. -->
    <Content Include="docs\**\*.md;README.md;sample-home\**\*" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Data\**\*.cs;Domain\**\*.cs;Application\**\*.cs;Infrastructure\**\*.cs;Controllers\**\*.cs;Composition\**\*.cs;Library\**\*.cs;Program.cs;.editorconfig;Dockerfile" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="src\**\*.ts" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="tsconfig.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="package.json;package-lock.json" />
    <Compile Remove="tests\**" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
    <!-- The compiler's own folder is not content; the Web SDK skips it for wwwroot, this says so for the root too. -->
    <Content Remove="node_modules\**" />
    <None Remove="node_modules\**" />
  </ItemGroup>

</Project>
