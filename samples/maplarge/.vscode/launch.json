{
  // F5: The Shed under the debugger, and the browser opens on :5120 when it is listening.
  // To browse a folder of your own, add "FILES__HOME": "C:\\some\\folder" to env.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Shed: run (F5)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Shed: build",
      "program": "${workspaceFolder}/bin/Debug/net10.0/TestProject.dll",
      "cwd": "${workspaceFolder}",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5120"
      },
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
