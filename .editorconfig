# The mechanical half of docs/STYLE.md, applied by the editor and the
# compiler instead of by review. Rules a tool cannot check (naming that
# reads well, comments that say why) stay in that document.
root = true

[*]
charset = utf-8
# LF, which is what git has stored for every file here since the first commit.
# .gitattributes is what makes that true in the working tree as well, on every
# machine rather than only on the ones whose core.autocrlf agrees (ADR-028).
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# The dataset and the published PDFs are written by other tools; leave them alone.
[*.{json,pdf,png,jpg,svg}]
trim_trailing_whitespace = false

[*.md]
# Two trailing spaces are a hard line break in markdown.
trim_trailing_whitespace = false
max_line_length = 100

[*.cs]
indent_size = 4
max_line_length = 120

# Usings inside the namespace-free top of the file, System first, no unused ones.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0005.severity = warning

# var only where the type is obvious from the right-hand side.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression bodies for one-liners, blocks for anything with a decision in it.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Braces always: a single-line if body without them is how a second statement gets lost.
csharp_prefer_braces = true:warning

# Modern C# the codebase already uses.
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion

[*.{ts,tsx,mjs,js}]
indent_size = 2
max_line_length = 100
quote_type = single

[*.{yml,yaml}]
indent_size = 2

[*.css]
indent_size = 2
